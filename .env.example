# Database Connection
# For effortless local zero-setup development, SQLite is configured:
DATABASE_URL="file:./dev.db"

# When ready to connect to PostgreSQL (Neon, Supabase, Railway, etc.), update to:
# DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# NextAuth / Auth Secret
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="healing-and-growth-journal-development-secret-key-32chars"

# Paystack API Keys (Test keys for Nigeria / NGN)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_placeholder_key"
PAYSTACK_SECRET_KEY="sk_test_placeholder_key"

# Resend Email (Optional for contact notifications and order receipt)
RESEND_API_KEY="re_placeholder_key"
CONTACT_NOTIFICATION_EMAIL="glory@healingandgrowthjournal.com"
